# ===== Batería de Riesgo Psicosocial · Sanithelp =====
# Copia este archivo a .env (nunca lo subas al repositorio). En Railway se cargan como Variables del servicio.

NODE_ENV=development
PORT=3000

# Cadena de conexión de PostgreSQL. En Railway: referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://usuario:clave@localhost:5432/bateria
# "true" si la base exige SSL (Railway por red pública). Con la URL interna de Railway déjalo en false.
DATABASE_SSL=false
# Opcional (recomendado en producción): URL del dueño de las tablas, solo para migrar. DATABASE_URL pasa a ser el rol
# limitado `sanithelp_app` creado con ops/db-roles.sql (así la app no puede quitar los triggers de la auditoría).
MIGRATION_DATABASE_URL=

# URL pública de la app (https en producción). Se usa para validar el origen de las peticiones.
APP_BASE_URL=http://localhost:3000

# Secreto para firmar/derivar hashes de sesión. Mínimo 32 caracteres aleatorios:  openssl rand -base64 48
SESSION_SECRET=

# Clave AES-256 (32 bytes en base64) para cifrar datos personales y respuestas:  openssl rand -base64 32
# IMPORTANTE: si se pierde esta clave, los datos cifrados NO se pueden recuperar. Guárdala en un gestor de secretos.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
# Tras rotar la clave, conserva las anteriores aquí para poder leer datos antiguos: 1:base64,2:base64
DATA_ENCRYPTION_KEYS_OLD=

# Clave distinta de la anterior (32 bytes en base64) para el índice ciego de usuario/cédula:  openssl rand -base64 32
# No se puede cambiar sin regenerar los índices.
BLIND_INDEX_KEY=

# Primer administrador (opcional). Se crea solo si no existe ninguno.
# Mínimo 12 caracteres. Bórralas de las variables después del primer ingreso.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Ruta del build del cliente (relativa a la carpeta desde donde se ejecuta el servidor). Normalmente no se toca.
CLIENT_DIST=../client/dist
